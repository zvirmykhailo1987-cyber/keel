{
  "skill": "frontend",
  "cases": [
    {
      "prompt": "Зроби сторінку налаштувань профілю на React.",
      "should_trigger": true,
      "expect": ["стани завантаження, порожній і помилка", "нативні елементи й клавіатура", "перевірка на 320 CSS px", "рендер у браузері перед готово"]
    },
    {
      "prompt": "INP 450 мс на мобільних, що робити?",
      "should_trigger": true,
      "expect": ["поріг 200 мс на 75-му перцентилі", "польові дані проти лабораторії", "довгі задачі в обробниках"]
    },
    {
      "prompt": "Гейт контрасту дає нуль порушень на всіх екранах, можна релізити?",
      "should_trigger": true,
      "expect": ["G27 перевірити статус і ресурси", "калібрування гейта на зламаній сторінці", "G41 парсер кольору"]
    },
    {
      "prompt": "Додай темну тему: деякі елементи не перемикаються.",
      "should_trigger": true,
      "expect": ["G28 неіснуючий токен", "контраст окремо для кожної теми", "G34 словник однієї теми"]
    },
    {
      "prompt": "Прев'ю широкої таблиці на мобільному обрізається, але є прокрутка. Це нормально?",
      "should_trigger": true,
      "expect": ["G37 прокрутка легалізує обрізку", "вимір різниці ширини вмісту й контейнера", "видимий натяк на прокрутку"]
    },
    {
      "prompt": "Застосунок на Swift падає після повернення з фону.",
      "should_trigger": false,
      "expect": ["маршрут до навички mobile"]
    },
    {
      "prompt": "SQL-запит у бекенді виконується 8 секунд.",
      "should_trigger": false,
      "expect": ["маршрут до навички performance"]
    }
  ]
}
