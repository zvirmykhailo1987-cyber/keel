{
  "skill": "observability",
  "cases": [
    {
      "prompt": "Додай моніторинг до нашого API: зараз ми взагалі не знаємо, що відбувається в проді.",
      "should_trigger": true,
      "expect": ["критичні шляхи користувача", "SLI і SLO", "структуровані логи з trace_id", "тестове спрацювання алерта"]
    },
    {
      "prompt": "Алерти на CPU будять нас щоночі, а користувачі нічого не помічають. Що робити?",
      "should_trigger": true,
      "expect": ["алерт на симптом, а не причину", "багатовіконний burn rate", "видалити алерт без дії"]
    },
    {
      "prompt": "Інтегруй OpenTelemetry у сервіс і воркер черги.",
      "should_trigger": true,
      "expect": ["Collector між SDK і бекендом", "передача контексту через повідомлення черги", "семантичні конвенції", "частка семплювання"]
    },
    {
      "prompt": "Хочу додати user_id як мітку до всіх метрик Prometheus. Ок?",
      "should_trigger": true,
      "expect": ["ризик кардинальності", "user_id у трейси або логи"]
    },
    {
      "prompt": "Панель показує нуль помилок третю добу. Значить, усе добре?",
      "should_trigger": true,
      "expect": ["відсутність метрики не дорівнює нулю", "сторож мертвого", "перевірка ін'єкцією збою"]
    },
    {
      "prompt": "Цей запит повільний: знайди, що в ньому гальмує, профайлером.",
      "should_trigger": false,
      "expect": ["маршрут до навички performance"]
    },
    {
      "prompt": "Виправ опечатку в заголовку README.",
      "should_trigger": false,
      "expect": ["навичка не потрібна"]
    }
  ]
}
